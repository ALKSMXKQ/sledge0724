{"id":"combo_intersection_yield_ped_001","category":"compositional_generalization","group":"intersection_turn_yield_pedestrian","prompt":"At an intersection, the ego vehicle turns while yielding to a pedestrian crossing the road.","expect":{"road_layer.road_topology":"intersection","actor_layer.primary_actor":"pedestrian","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":{"any_of":["lateral_conflict","crossing_path_conflict"]},"interaction_layer.interaction_goal":{"any_of":["yielding_conflict","near_miss"]},"risk_layer.risk_level":{"any_of":["mild","moderate"]}}}
{"id":"combo_intersection_yield_ped_002","category":"compositional_generalization","group":"intersection_turn_yield_pedestrian","prompt":"The ego car turns right at a junction and slows down for a pedestrian in the crosswalk.","expect":{"road_layer.road_topology":"intersection","road_layer.has_crosswalk":true,"actor_layer.primary_actor":"pedestrian","actor_layer.actor_role":"crossing_actor","interaction_layer.interaction_goal":{"any_of":["yielding_conflict","braking_pressure","near_miss"]},"risk_layer.risk_level":{"any_of":["mild","moderate"]}}}
{"id":"combo_intersection_yield_ped_003","category":"compositional_generalization","group":"intersection_turn_yield_pedestrian","prompt":"At a crosswalk inside an intersection, a pedestrian crosses while the ego vehicle yields with enough distance.","expect":{"road_layer.road_topology":{"any_of":["intersection","crosswalk_area"]},"road_layer.has_crosswalk":true,"actor_layer.primary_actor":"pedestrian","interaction_layer.interaction_goal":{"any_of":["yielding_conflict","near_miss"]},"risk_layer.risk_level":{"any_of":["mild","moderate"]}}}

{"id":"combo_occluded_cyclist_001","category":"compositional_generalization","group":"occluded_cyclist_crossing","prompt":"A cyclist is hidden behind a parked vehicle and suddenly crosses into the ego path.","expect":{"actor_layer.primary_actor":"cyclist","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":"lateral_conflict","object_layer.occlusion.enabled":true,"object_layer.occlusion.occluder_type":"parked_vehicle","risk_layer.risk_level":"aggressive"}}
{"id":"combo_occluded_cyclist_002","category":"compositional_generalization","group":"occluded_cyclist_crossing","prompt":"A bicycle rider emerges from behind a truck and crosses in front of the ego car.","expect":{"actor_layer.primary_actor":"cyclist","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":"lateral_conflict","object_layer.occlusion.enabled":true,"object_layer.occlusion.occluder_type":"truck"}}

{"id":"combo_construction_block_001","category":"compositional_generalization","group":"construction_lane_blocking","prompt":"A construction barrier blocks the ego lane ahead, forcing the ego vehicle to slow down.","expect":{"road_layer.road_topology":"construction_zone","actor_layer.primary_actor":"static_obstacle","actor_layer.actor_role":"blocking_actor","object_layer.static_obstacle.enabled":true,"object_layer.static_obstacle.obstacle_type":{"any_of":["barrier","construction_zone"]},"interaction_layer.conflict_type":"lane_blocking_conflict","interaction_layer.interaction_goal":"trajectory_blocking"}}
{"id":"combo_construction_block_002","category":"compositional_generalization","group":"construction_lane_blocking","prompt":"Traffic cones occupy the ego lane near a work zone.","expect":{"road_layer.road_topology":"construction_zone","actor_layer.primary_actor":"static_obstacle","object_layer.static_obstacle.enabled":true,"object_layer.static_obstacle.obstacle_type":"cone","interaction_layer.conflict_type":"lane_blocking_conflict"}}