{"id":"challenge_subject_001","category":"challenge_subject_event_order","group":"decoy_actor","prompt":"A pedestrian is waiting safely on the sidewalk, but the lead car ahead suddenly brakes hard in the ego lane.","expect":{"actor_layer.primary_actor":"lead_vehicle","actor_layer.actor_role":"braking_actor","interaction_layer.conflict_type":"longitudinal_conflict","interaction_layer.conflict_direction":"front","motion_layer.hazard_event_type":{"any_of":["lead_vehicle_braking","hard_stop_ahead"]},"risk_layer.risk_level":"aggressive"}}
{"id":"challenge_subject_002","category":"challenge_subject_event_order","group":"decoy_actor","prompt":"A bicycle is strapped to a parked SUV on the shoulder; the actual hazard is the front vehicle stopping short ahead of ego.","expect":{"actor_layer.primary_actor":"lead_vehicle","actor_layer.actor_role":"braking_actor","interaction_layer.conflict_type":"longitudinal_conflict","interaction_layer.conflict_direction":"front","motion_layer.hazard_event_type":{"any_of":["lead_vehicle_braking","hard_stop_ahead"]},"interaction_layer.distance_relation":{"any_of":["close","medium","short_headway"]}}}
{"id":"challenge_subject_003","category":"challenge_subject_event_order","group":"decoy_actor","prompt":"Ignore the pedestrian standing on the median; a sedan from the right lane squeezes into ego's lane with no room.","expect":{"actor_layer.primary_actor":"cutin_vehicle","actor_layer.actor_role":"merging_actor","interaction_layer.conflict_type":"merging_conflict","interaction_layer.conflict_direction":"right_merge","interaction_layer.distance_relation":"small_gap","risk_layer.risk_level":"aggressive"}}
{"id":"challenge_subject_004","category":"challenge_subject_event_order","group":"decoy_actor","prompt":"The parked truck is only an occluder, and a child comes out from behind it into the ego vehicle's path.","expect":{"actor_layer.primary_actor":"pedestrian","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":{"any_of":["lateral_conflict","crossing_path_conflict"]},"object_layer.occlusion.enabled":true,"object_layer.occlusion.occluder_type":"truck","motion_layer.hazard_event_type":"enter_ego_lane"}}
{"id":"challenge_order_001","category":"challenge_subject_event_order","group":"event_order","prompt":"First the ego starts a left turn, then a previously hidden oncoming car appears from the far side and continues straight through the conflict area.","expect":{"actor_layer.primary_actor":"vehicle","actor_layer.actor_role":"approaching_actor","interaction_layer.conflict_type":"oncoming_conflict","interaction_layer.conflict_direction":"opposite","motion_layer.ego_maneuver":"left_turn","motion_layer.hazard_event_type":{"any_of":["left_turn_across_oncoming","ego_left_turn_across_oncoming","oncoming_through_conflict"]}}}
{"id":"challenge_order_002","category":"challenge_subject_event_order","group":"event_order","prompt":"A van ahead slows normally, but after that a cyclist darts from the left curb across the ego lane, which is the critical event.","expect":{"actor_layer.primary_actor":"cyclist","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":{"any_of":["lateral_conflict","crossing_path_conflict"]},"interaction_layer.conflict_direction":"left_to_right","motion_layer.hazard_event_type":"path_crossing"}}
{"id":"challenge_order_003","category":"challenge_subject_event_order","group":"event_order","prompt":"A car is parked to the right of the lane; seconds later a scooter rider emerges from behind that car and enters the ego path.","expect":{"actor_layer.primary_actor":"cyclist","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":{"any_of":["lateral_conflict","crossing_path_conflict"]},"object_layer.occlusion.enabled":true,"object_layer.occlusion.occluder_type":"parked_vehicle","motion_layer.hazard_event_type":"enter_ego_lane"}}
{"id":"challenge_position_001","category":"challenge_subject_event_order","group":"position_scope","prompt":"A pedestrian on the far sidewalk is not crossing; the hazard is a vehicle crossing from the left side of the intersection in front of ego.","expect":{"actor_layer.primary_actor":"vehicle","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":{"any_of":["lateral_conflict","crossing_path_conflict"]},"interaction_layer.conflict_direction":"left_to_right","road_layer.road_topology":"intersection"}}
{"id":"challenge_position_002","category":"challenge_subject_event_order","group":"position_scope","prompt":"The ego vehicle is near a crosswalk, but the obstacle to generate is a construction barrier blocking the ego lane ahead.","expect":{"actor_layer.primary_actor":"static_obstacle","actor_layer.actor_role":"blocking_actor","interaction_layer.conflict_type":"lane_blocking_conflict","interaction_layer.conflict_direction":"front","road_layer.road_topology":"construction_zone","object_layer.static_obstacle.obstacle_type":"barrier"}}
{"id":"challenge_position_003","category":"challenge_subject_event_order","group":"position_scope","prompt":"A bus passes in the opposite lane, while a pedestrian from the right curb steps into the ego lane ahead of the car.","expect":{"actor_layer.primary_actor":"pedestrian","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":{"any_of":["lateral_conflict","crossing_path_conflict"]},"interaction_layer.conflict_direction":"right_to_left","motion_layer.hazard_event_type":"enter_ego_lane"}}
{"id":"challenge_negation_001","category":"challenge_subject_event_order","group":"negation","prompt":"Do not create a cut-in: the adjacent car stays in its lane, while the lead vehicle brakes abruptly in front of ego.","expect":{"actor_layer.primary_actor":"lead_vehicle","actor_layer.actor_role":"braking_actor","interaction_layer.conflict_type":"longitudinal_conflict","interaction_layer.conflict_direction":"front","motion_layer.hazard_event_type":{"any_of":["lead_vehicle_braking","hard_stop_ahead"]},"risk_layer.risk_level":"aggressive"}}
{"id":"challenge_negation_002","category":"challenge_subject_event_order","group":"negation","prompt":"There is no pedestrian crossing; instead, traffic cones occupy the ego lane near a work zone.","expect":{"actor_layer.primary_actor":"static_obstacle","actor_layer.actor_role":"blocking_actor","interaction_layer.conflict_type":"lane_blocking_conflict","interaction_layer.conflict_direction":"front","road_layer.road_topology":"construction_zone","object_layer.static_obstacle.obstacle_type":"cone"}}
