{"id":"fine_direction_ped_right","category":"fine_control","group":"pedestrian_direction","prompt":"A pedestrian crosses from the right side, close to the ego vehicle, but not colliding.","expect":{"actor_layer.primary_actor":"pedestrian","interaction_layer.conflict_type":"lateral_conflict","interaction_layer.conflict_direction":"right_to_left","interaction_layer.distance_relation":"close","risk_layer.collision_allowed":false}}
{"id":"fine_direction_ped_left","category":"fine_control","group":"pedestrian_direction","prompt":"A pedestrian crosses from the left side, close to the ego vehicle, but not colliding.","expect":{"actor_layer.primary_actor":"pedestrian","interaction_layer.conflict_type":"lateral_conflict","interaction_layer.conflict_direction":"left_to_right","interaction_layer.distance_relation":"close","risk_layer.collision_allowed":false}}

{"id":"fine_direction_cutin_left","category":"fine_control","group":"cutin_direction","prompt":"A vehicle cuts in aggressively from the left lane with a small gap.","expect":{"actor_layer.primary_actor":"cutin_vehicle","actor_layer.actor_role":"merging_actor","interaction_layer.conflict_type":"merging_conflict","interaction_layer.conflict_direction":"left_merge","interaction_layer.distance_relation":"small_gap","risk_layer.risk_level":"aggressive"}}
{"id":"fine_direction_cutin_right","category":"fine_control","group":"cutin_direction","prompt":"A vehicle cuts in aggressively from the right lane with a small gap.","expect":{"actor_layer.primary_actor":"cutin_vehicle","actor_layer.actor_role":"merging_actor","interaction_layer.conflict_type":"merging_conflict","interaction_layer.conflict_direction":"right_merge","interaction_layer.distance_relation":"small_gap","risk_layer.risk_level":"aggressive"}}

{"id":"fine_risk_ped_mild","category":"fine_control","group":"risk_intensity_pedestrian","prompt":"A pedestrian slowly crosses ahead of the ego vehicle with enough reaction distance.","expect":{"actor_layer.primary_actor":"pedestrian","interaction_layer.conflict_type":"lateral_conflict","risk_layer.risk_level":"mild","risk_layer.collision_allowed":false}}
{"id":"fine_risk_ped_aggressive","category":"fine_control","group":"risk_intensity_pedestrian","prompt":"A pedestrian suddenly crosses very close to the ego vehicle, creating a near-miss.","expect":{"actor_layer.primary_actor":"pedestrian","interaction_layer.conflict_type":"lateral_conflict","interaction_layer.distance_relation":"close","interaction_layer.interaction_goal":"near_miss","risk_layer.risk_level":"aggressive","risk_layer.collision_allowed":false}}

{"id":"fine_risk_lead_mild","category":"fine_control","group":"risk_intensity_lead_vehicle","prompt":"The lead vehicle slows down mildly, leaving enough reaction distance.","expect":{"actor_layer.primary_actor":"lead_vehicle","actor_layer.actor_role":"braking_actor","interaction_layer.conflict_type":"longitudinal_conflict","interaction_layer.conflict_direction":"front","risk_layer.risk_level":"mild"}}
{"id":"fine_risk_lead_aggressive","category":"fine_control","group":"risk_intensity_lead_vehicle","prompt":"The lead vehicle suddenly brakes hard at a very short headway.","expect":{"actor_layer.primary_actor":"lead_vehicle","actor_layer.actor_role":"braking_actor","interaction_layer.conflict_type":"longitudinal_conflict","interaction_layer.conflict_direction":"front","interaction_layer.distance_relation":"short_headway","risk_layer.risk_level":"aggressive"}}

{"id":"fine_actor_pedestrian","category":"fine_control","group":"actor_type_crossing","prompt":"A pedestrian crosses from the right side in front of the ego vehicle.","expect":{"actor_layer.primary_actor":"pedestrian","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":"lateral_conflict","interaction_layer.conflict_direction":"right_to_left"}}
{"id":"fine_actor_cyclist","category":"fine_control","group":"actor_type_crossing","prompt":"A cyclist crosses from the right side in front of the ego vehicle.","expect":{"actor_layer.primary_actor":"cyclist","actor_layer.actor_role":"crossing_actor","interaction_layer.conflict_type":"lateral_conflict","interaction_layer.conflict_direction":"right_to_left"}}
{"id":"fine_actor_vehicle","category":"fine_control","group":"actor_type_crossing","prompt":"A vehicle crosses from the right side at the intersection in front of the ego vehicle.","expect":{"road_layer.road_topology":"intersection","actor_layer.primary_actor":"vehicle","interaction_layer.conflict_type":"crossing_path_conflict","interaction_layer.conflict_direction":"right_to_left"}}

{"id":"fine_visibility_visible","category":"fine_control","group":"visibility_control","prompt":"A pedestrian visibly crosses near the crosswalk in front of the ego vehicle.","expect":{"actor_layer.primary_actor":"pedestrian","road_layer.has_crosswalk":true,"object_layer.occlusion.enabled":false,"validation_layer.require_visibility_match":false}}
{"id":"fine_visibility_hidden_parked","category":"fine_control","group":"visibility_control","prompt":"A pedestrian is partially occluded by a parked vehicle and suddenly crosses the road.","expect":{"actor_layer.primary_actor":"pedestrian","object_layer.occlusion.enabled":true,"object_layer.occlusion.occluder_type":"parked_vehicle","object_layer.occlusion.occlusion_level":"partial","validation_layer.require_visibility_match":true}}
{"id":"fine_visibility_hidden_truck","category":"fine_control","group":"visibility_control","prompt":"A pedestrian is hidden behind a truck before entering the ego vehicle's path.","expect":{"actor_layer.primary_actor":"pedestrian","object_layer.occlusion.enabled":true,"object_layer.occlusion.occluder_type":"truck","validation_layer.require_visibility_match":true}}
{"id":"fine_visibility_hidden_bus","category":"fine_control","group":"visibility_control","prompt":"A pedestrian is occluded by a bus near the crosswalk and then crosses ahead.","expect":{"actor_layer.primary_actor":"pedestrian","road_layer.has_crosswalk":true,"object_layer.occlusion.enabled":true,"object_layer.occlusion.occluder_type":"bus","validation_layer.require_visibility_match":true}}

{"id":"fine_distance_small_gap","category":"fine_control","group":"distance_control_cutin","prompt":"A vehicle cuts in with a small gap directly in front of the ego car.","expect":{"actor_layer.primary_actor":"cutin_vehicle","interaction_layer.conflict_type":"merging_conflict","interaction_layer.distance_relation":"small_gap"}}
{"id":"fine_distance_medium_gap","category":"fine_control","group":"distance_control_cutin","prompt":"A vehicle changes lanes ahead of the ego car with a comfortable gap.","expect":{"actor_layer.primary_actor":"cutin_vehicle","interaction_layer.conflict_type":"merging_conflict","interaction_layer.distance_relation":{"any_of":["medium","small_gap"]},"risk_layer.risk_level":{"any_of":["mild","moderate"]}}}

{"id":"fine_speed_fast_oncoming","category":"fine_control","group":"speed_control_oncoming","prompt":"At an unprotected left turn, a fast oncoming vehicle approaches the conflict zone.","expect":{"road_layer.generated_road_layout":"unprotected_left_turn","interaction_layer.conflict_type":"oncoming_conflict","interaction_layer.speed_relation":"fast_approach","risk_layer.risk_level":"aggressive"}}
{"id":"fine_speed_normal_oncoming","category":"fine_control","group":"speed_control_oncoming","prompt":"At an unprotected left turn, an oncoming vehicle approaches at normal speed.","expect":{"road_layer.generated_road_layout":"unprotected_left_turn","interaction_layer.conflict_type":"oncoming_conflict","interaction_layer.speed_relation":{"any_of":["normal","fast_approach"]}}}

{"id":"fine_collision_nearmiss","category":"fine_control","group":"collision_control","prompt":"Generate a near-miss pedestrian crossing without collision.","expect":{"actor_layer.primary_actor":"pedestrian","interaction_layer.interaction_goal":"near_miss","risk_layer.collision_allowed":false}}
{"id":"fine_collision_risk","category":"fine_control","group":"collision_control","prompt":"Generate a dangerous pedestrian crossing with high collision risk but no initial collision.","expect":{"actor_layer.primary_actor":"pedestrian","interaction_layer.interaction_goal":{"any_of":["collision_risk","near_miss"]},"risk_layer.risk_level":"aggressive","risk_layer.collision_allowed":false}}